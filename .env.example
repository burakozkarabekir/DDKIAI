# ======================================================================
#  AI Impact Merkezi — ayarlar. Bu dosyayı .env olarak kopyalayıp doldurun.
#  Değişiklikten sonra: docker compose up -d   (ya da servisi yeniden başlatın)
# ======================================================================

# --- Uygulama ---
APP_NAME=AI Impact Merkezi
ORG_NAME=Doğuş Otomotiv · Dijital Dönüşüm
# Üretimde uzun rastgele bir değer verin: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=degistir-beni
# 1 = ilk açılışta demo verisi yükle. Demo verisi uygulama içinden kaldırılabilir: Ayarlar → Demo verisini temizle
# (kaldırıldıktan sonra bir daha yüklenmez). Sıfırdan başlamak için: SEED_DEMO=0
SEED_DEMO=1

# --- Giriş ekranı ---
# 0 = kapalı: herkes "Dijital Dönüşüm Ekibi" ortak hesabıyla girer (şu anki tercih)
# 1 = açık: e-posta + parola, roller (Üst Yönetim, DT, görüntüleyici) devreye girer
AUTH_ENABLED=0
ADMIN_EMAIL=admin@demo.local
ADMIN_PASSWORD=Admin123!
COOKIE_SECURE=0
SESSION_HOURS=12

# --- Depolama ---
# Docker'da DATA_DIR=/data ve STORAGE_DIR=/files sabittir; klasörleri docker-compose.yml'deki volumes ile bağlayın.
# Docker'sız kurulumda yolları burada verin:
# DATA_DIR=/opt/ai-impact/data
# STORAGE_DIR=/mnt/nas/ai-impact
MAX_UPLOAD_MB=100

# --- Şirket içi AI uç noktası ----------------------------------------
# En az şu üç satırı doldurun: AI_BASE_URL, AI_API_KEY, AI_MODEL. AI_PROVIDER=auto iken tip adresten algılanır.
# AI_PROVIDER:
#   auto      → varsayılan; *.openai.azure.com → azure, adres "anthropic" içeriyorsa → anthropic, diğerleri → openai
#   openai    → OpenAI uyumlu /chat/completions (vLLM, LiteLLM, Ollama, kurumsal AI gateway, OpenAI)
#               AI_BASE_URL=https://ai-gateway.sirket.local/v1     (sonunda /v1 olur, /chat/completions yazılmaz)
#   azure     → Azure OpenAI
#               AI_BASE_URL=https://<kaynak-adi>.openai.azure.com   AI_MODEL=<deployment adı>
#   anthropic → Anthropic Messages API uyumlu gateway
#               AI_BASE_URL=https://gateway.sirket.local           (uygulama /v1/messages ekler)
#   AI_BASE_URL boşsa uygulama demo (kural tabanlı) modunda çalışır.
AI_PROVIDER=auto
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_AZURE_API_VERSION=2024-10-21
# Anahtar standart dışı bir başlıkta gönderilecekse (ör. API Management): AI_AUTH_HEADER=Ocp-Apim-Subscription-Key
AI_AUTH_HEADER=
# Ek başlıklar (JSON): AI_EXTRA_HEADERS={"X-Tenant": "dogus"}
AI_EXTRA_HEADERS=
# Kurum içi sertifika otoritesi: AI_CA_BUNDLE=/etc/ssl/certs/sirket-ca.pem   (son çare: AI_VERIFY_TLS=0)
AI_CA_BUNDLE=
AI_VERIFY_TLS=1
AI_TIMEOUT=180
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=4000
# Tek çağrıda gönderilecek en fazla metin. 128K token'lık model için ~200000, 32K için ~60000 uygundur.
AI_MAX_CONTEXT_CHARS=60000
