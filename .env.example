# --- Uygulama ---
APP_NAME=AI Impact Merkezi
ORG_NAME=Doğuş Otomotiv · Dijital Dönüşüm
# Üretimde mutlaka uzun rastgele bir değer verin: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=degistir-beni
# HTTPS arkasında çalışıyorsa 1
COOKIE_SECURE=0
SESSION_HOURS=12
MAX_UPLOAD_MB=50
# 1 = ilk açılışta demo verisi yükle; gerçek kullanımda 0
SEED_DEMO=1
# İlk yönetici hesabı (veritabanı boşken oluşturulur)
ADMIN_EMAIL=admin@demo.local
ADMIN_PASSWORD=Admin123!

# --- Şirket içi AI uç noktası ---
# openai   : OpenAI uyumlu /chat/completions (vLLM, LiteLLM, Ollama, kurumsal gateway) -> AI_BASE_URL=https://ai.sirket.local/v1
# azure    : Azure OpenAI -> AI_BASE_URL=https://<kaynak>.openai.azure.com , AI_MODEL=<deployment adı>
# anthropic: Anthropic Messages API uyumlu gateway -> AI_BASE_URL=https://gateway.sirket.local
# mock     : AI bağlı değil, kural tabanlı demo çıktıları
AI_PROVIDER=mock
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_AZURE_API_VERSION=2024-10-21
AI_TIMEOUT=120
# Kurum içi sertifika otoritesi kullanılıyorsa SSL_CERT_FILE verin; son çare 0
AI_VERIFY_TLS=1
AI_MAX_CONTEXT_CHARS=60000
